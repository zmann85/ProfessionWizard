package-as: ProfessionWizard

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# ProfessionWizard_Data (GPL v2, its own add-on) comes in the same zip, as a folder of its own next to Profession Wizard
move-folders:
  ProfessionWizard/ProfessionWizard_Data: ProfessionWizard_Data

ignore:
  - tools
  - README.md
  - CURSEFORGE.md
  - logo.svg
  - .gitignore

embedded-libraries:
  - libstub
  - callbackhandler
  - libdatabroker-1-1
  - libdbicon-1-0
